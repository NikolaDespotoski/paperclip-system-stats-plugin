{
  "name": "paperclip-plugin-system-stats",
  "version": "0.1.0",
  "description": "Paperclip plugin: real-time CPU, RAM, disk, network and Docker monitoring for execution hosts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1012.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "license": "UNLICENSED",
  "private": true
}
